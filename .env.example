# Copy this file to ".env" and fill in real values.
# .env is git-ignored, so your passwords never reach GitHub.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# Database: "sqlite" (zero setup) or "mysql"
DB_ENGINE=sqlite

# Only used when DB_ENGINE=mysql
DB_NAME=translator_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Translation engine to try first: "google" (default), "gemini" or "mymemory".
# Use mymemory while Google is rate-limiting your network; the other engine is still the backup.
PRIMARY_ENGINE=google

# Google Gemini (optional, free key from https://aistudio.google.com -> "Get API key").
# Gives much better translations and language detection. Leave empty to skip Gemini.
# Tip: with a key, set PRIMARY_ENGINE=gemini above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
